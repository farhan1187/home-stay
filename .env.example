# ==============================================================================
# Homestay Manager - Environment Variables
# Copy this file to .env and fill in your Supabase project credentials.
# ==============================================================================

# Supabase Project URL (found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (found in Project Settings -> API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Currency Symbol (default is ₹ if left blank)
VITE_CURRENCY_SYMBOL=₹
